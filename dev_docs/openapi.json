    "api/earthquakes": {
      "get": {
        "tags": [
          "geo_events"
        ],
        "operationId": "fetch_earthquakes",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "description": "Start of the time range (required), RFC 3339",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End of the time range (optional, defaults to now), RFC 3339",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "description": "Latitude of the search centre; requires `longitude` and `radius_km`",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "description": "Longitude of the search centre; requires `latitude` and `radius_km`",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "description": "Search radius in kilometres; requires `latitude` and `longitude`",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of most recent events to return (default 1000, clamped to 1..=10000)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Most recent earthquakes in chronological order, bounded by `limit`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Earthquake"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "geo_events"
        ],
        "operationId": "store_earthquake",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEarthquake"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Earthquake already stored for this device and timestamp; ignored"
          },
          "201": {
            "description": "Earthquake stored"
          },
          "400": {
            "description": "Invalid payload or unknown device"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
