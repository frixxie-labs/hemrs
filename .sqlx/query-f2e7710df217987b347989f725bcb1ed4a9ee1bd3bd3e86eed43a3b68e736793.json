  "db_name": "PostgreSQL",
  "query": "SELECT timestamp AS \"timestamp!\", value AS \"value!\", unit AS \"unit!\", device_name AS \"device_name!\", device_location AS \"device_location!\", sensor_name AS \"sensor_name!\" FROM (SELECT m.ts AS timestamp, m.value, s.unit, d.name AS device_name, d.location AS device_location, s.name AS sensor_name FROM measurements m JOIN devices d ON d.id = m.device_id JOIN sensors s ON s.id = m.sensor_id WHERE m.device_id = $1 ORDER BY m.ts DESC LIMIT $2) recent ORDER BY timestamp",
