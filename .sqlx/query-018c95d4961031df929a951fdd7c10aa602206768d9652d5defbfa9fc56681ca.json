  "query": "SELECT timestamp AS \"timestamp!\", device_id AS \"device_id!: DeviceId\", latitude, longitude FROM (SELECT ts AS timestamp, device_id, ST_Y(geom::geometry) AS latitude, ST_X(geom::geometry) AS longitude FROM lightning_strikes WHERE ts >= $1 AND ts <= $2 AND ($5::float8 IS NULL OR ST_DWithin(geom, ST_SetSRID(ST_MakePoint($4, $3), 4326)::geography, $5)) ORDER BY ts DESC LIMIT $6) recent ORDER BY timestamp",
